<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <!-- Opt in to FCM registration by Firebase Installation ID (onRegistered). -->
    <meta-data android:name="firebase_messaging_installation_id_enabled" android:value="true" />
    <service android:name="dev.pushharbor.spike.PushService" android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
