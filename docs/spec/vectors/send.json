{
  "description": "Validation of a send request before any lookup (spec: send.md). body is synthetic: len bytes with the aes128gcm header fields rs and idlen set (default idlen 65); the relay never decrypts. Header names are case-insensitive; absent headers are omitted. expect.status 201 means the request passes validation, with the normalized values that are forwarded to the provider.",
  "vectors": [
    { "name": "minimal", "headers": { "Content-Encoding": "aes128gcm" }, "body": { "len": 200, "rs": 4096 },
      "expect": { "status": 201, "ttl": 2419200, "urgency": "normal", "topic": null, "idempotency_key": null } },
    { "name": "all optional headers", "headers": { "Content-Encoding": "aes128gcm", "TTL": "60", "Urgency": "high", "Topic": "chat_42", "Idempotency-Key": "msg-7f3a:1" }, "body": { "len": 200, "rs": 4096 },
      "expect": { "status": 201, "ttl": 60, "urgency": "high", "topic": "chat_42", "idempotency_key": "msg-7f3a:1" } },
    { "name": "case-insensitive values, surrounding spaces", "headers": { "Content-Encoding": " AES128GCM ", "Urgency": "Very-Low" }, "body": { "len": 200, "rs": 4096 },
      "expect": { "status": 201, "ttl": 2419200, "urgency": "very-low", "topic": null, "idempotency_key": null } },
    { "name": "TTL 0", "headers": { "Content-Encoding": "aes128gcm", "TTL": "0" }, "body": { "len": 200, "rs": 4096 },
      "expect": { "status": 201, "ttl": 0, "urgency": "normal", "topic": null, "idempotency_key": null } },
    { "name": "TTL above 28 days is clamped", "headers": { "Content-Encoding": "aes128gcm", "TTL": "99999999999999999999" }, "body": { "len": 200, "rs": 4096 },
      "expect": { "status": 201, "ttl": 2419200, "urgency": "normal", "topic": null, "idempotency_key": null } },
    { "name": "body at the cap", "headers": { "Content-Encoding": "aes128gcm" }, "body": { "len": 2900, "rs": 4096 },
      "expect": { "status": 201, "ttl": 2419200, "urgency": "normal", "topic": null, "idempotency_key": null } },
    { "name": "body padded to rs 2900", "headers": { "Content-Encoding": "aes128gcm" }, "body": { "len": 2900, "rs": 2900 },
      "expect": { "status": 201, "ttl": 2419200, "urgency": "normal", "topic": null, "idempotency_key": null } },
    { "name": "body one byte over the cap", "headers": { "Content-Encoding": "aes128gcm" }, "body": { "len": 2901, "rs": 4096 },
      "expect": { "status": 413 } },
    { "name": "missing Content-Encoding", "headers": {}, "body": { "len": 200, "rs": 4096 }, "expect": { "status": 400 } },
    { "name": "legacy aesgcm encoding", "headers": { "Content-Encoding": "aesgcm" }, "body": { "len": 200, "rs": 4096 }, "expect": { "status": 400 } },
    { "name": "empty body", "headers": { "Content-Encoding": "aes128gcm" }, "body": { "len": 0, "rs": 4096 }, "expect": { "status": 400 } },
    { "name": "shorter than the aes128gcm overhead", "headers": { "Content-Encoding": "aes128gcm" }, "body": { "len": 102, "rs": 4096 }, "expect": { "status": 400 } },
    { "name": "key id is not a P-256 key", "headers": { "Content-Encoding": "aes128gcm" }, "body": { "len": 200, "rs": 4096, "idlen": 0 }, "expect": { "status": 400 } },
    { "name": "more than one record", "headers": { "Content-Encoding": "aes128gcm" }, "body": { "len": 1000, "rs": 512 }, "expect": { "status": 400 } },
    { "name": "negative TTL", "headers": { "Content-Encoding": "aes128gcm", "TTL": "-1" }, "body": { "len": 200, "rs": 4096 }, "expect": { "status": 400 } },
    { "name": "fractional TTL", "headers": { "Content-Encoding": "aes128gcm", "TTL": "1.5" }, "body": { "len": 200, "rs": 4096 }, "expect": { "status": 400 } },
    { "name": "unknown Urgency", "headers": { "Content-Encoding": "aes128gcm", "Urgency": "urgent" }, "body": { "len": 200, "rs": 4096 }, "expect": { "status": 400 } },
    { "name": "Topic with a dot", "headers": { "Content-Encoding": "aes128gcm", "Topic": "chat.42" }, "body": { "len": 200, "rs": 4096 }, "expect": { "status": 400 } },
    { "name": "Topic of 33 characters", "headers": { "Content-Encoding": "aes128gcm", "Topic": "ttttttttttttttttttttttttttttttttt" }, "body": { "len": 200, "rs": 4096 }, "expect": { "status": 400 } },
    { "name": "Idempotency-Key with a space", "headers": { "Content-Encoding": "aes128gcm", "Idempotency-Key": "msg 1" }, "body": { "len": 200, "rs": 4096 }, "expect": { "status": 400 } },
    { "name": "Idempotency-Key of 65 characters", "headers": { "Content-Encoding": "aes128gcm", "Idempotency-Key": "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk" }, "body": { "len": 200, "rs": 4096 }, "expect": { "status": 400 } }
  ]
}
