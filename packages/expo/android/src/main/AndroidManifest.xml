<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Android 17+: needed to reach a relay on a private network (requested at runtime). -->
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
  <application>
    <!-- FCM targets this device by Firebase Installation ID (onRegistered), spec: registration.md. -->
    <meta-data android:name="firebase_messaging_installation_id_enabled" android:value="true" />
    <service android:name="dev.pushharbor.expo.PushService" android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
